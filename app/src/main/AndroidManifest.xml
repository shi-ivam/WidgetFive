<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <receiver
            android:name="com.nothing.hearthstone.clock.provider.AnalogWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/analog_clock_widget_info" />
        </receiver>

        <receiver
            android:name="com.nothing.hearthstone.clock.provider.DigitalWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/digital_clock_widget_info" />
        </receiver>

        <receiver
            android:name="com.nothing.hearthstone.clock.provider.WorldWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/world_clock_widget_info" />
        </receiver>

        <receiver
            android:name="com.nothing.hearthstone.quicklook.QLTransparentWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ql_transparent_widget_info" />
        </receiver>

        <receiver
            android:name="com.nothing.hearthstone.quicklook.QLCardModeWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ql_card_widget_info" />
        </receiver>

        <receiver
            android:name="com.nothing.hearthstone.photo.provider.PhotoWidgetRectangleProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/photo_rectangle_widget_info" />
        </receiver>

        <receiver
            android:name="com.nothing.hearthstone.photo.provider.PhotoWidgetCircleProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/photo_circle_widget_info" />
        </receiver>

        <receiver
            android:name="com.nothing.hearthstone.compass.provider.CompassProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/compass_widget_info" />
        </receiver>

        <activity
            android:name="com.nothing.hearthstone.clock.ui.AnalogClockConfigureActivity"
            android:exported="true" />

        <activity
            android:name="com.nothing.hearthstone.clock.ui.WorldClockConfigureActivity"
            android:exported="true" />

        <activity
            android:name="com.nothing.hearthstone.quicklook.QuickLookSettingsActivity"
            android:exported="true" />

        <activity
            android:name="com.nothing.hearthstone.photo.ui.RectanglePhotoSettingActivity"
            android:exported="true" />

        <activity
            android:name="com.nothing.hearthstone.photo.ui.CirclePhotoSettingActivity"
            android:exported="true" />

        <activity
            android:name="com.nothing.hearthstone.compass.config.CompassSettingsActivity"
            android:exported="true" />

    </application>
</manifest>
